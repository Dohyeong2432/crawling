###############################################################################
# 이메일 발송 공통 설정 (notebooks/.env)
#
#  * 4개 자동화 프로젝트가 모두 이 파일 하나를 읽습니다.
#    비밀번호를 바꿀 때는 아래 EMAIL_PASSWORD 한 줄만 고치면 됩니다.
#  * 이 파일은 절대 외부로 공유하거나 메일에 첨부하지 마세요.
#  * 값 뒤의 " #설명" 은 주석으로 처리되어 값에 포함되지 않습니다.
###############################################################################

## ── 발송 계정 ───────────────────────────────────────────────────────────────
SEND_ADDR=발송계정@naver.com          #발송자 이메일 주소
SMTP_SERVER=smtp.naver.com           #SMTP 서버 주소
SMTP_PORT=587                        #SMTP 포트 (네이버 STARTTLS = 587)

## 네이버 "애플리케이션 비밀번호" (로그인 비밀번호 아님)
## 발급: 네이버 > 내정보 > 보안설정 > 2단계 인증 > 애플리케이션 비밀번호 관리
EMAIL_PASSWORD=여기에_새로_발급받은_앱비밀번호_입력

## ── 공통 경로 ───────────────────────────────────────────────────────────────
DOWNLOAD_FOLDER=C:/Users/Administrator/Downloads   #브라우저 다운로드 폴더

## ── 프로젝트별 수신자 (반드시 콤마로 구분) ──────────────────────────────────
## 금감원 제재내역 안내
RECV_ADDRS_FSS_SANCTION=수신자1@example.com, 수신자2@example.com

## 금융위 법령해석 최신사례
## [2026-08-25 이후 미사용] 법령해석_보도자료_최신자료_점검 의 fss_itp 가 같은 사이트를 수집함.
## 되살릴 수 있도록 항목은 남겨둠. 자세한 내용은 금융위_법령해석_최신사례/_사용안함_README.md 참고
RECV_ADDRS_FSC_INTERPRETATION=수신자1@example.com, 수신자2@example.com

## 법령 개정안 안내
RECV_ADDRS_LAW_REVISION=수신자1@example.com, 수신자2@example.com

## 법령해석/보도자료 최신자료 점검
RECV_ADDRS_PRESS=수신자1@example.com, 수신자2@example.com
